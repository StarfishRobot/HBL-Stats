##set functions
AddBox<-function (Type, GameStats, GameID){
GameDate<-substring(GameStats$data$fixture$startTimeLocal, 1, 10)
HomeTeam<-GameStats$data$fixture$competitors$name[1]
HomeScore<-as.integer(GameStats$data$fixture$competitors$score[1])
AwayTeam<-GameStats$data$fixture$competitors$name[2]
AwayScore<-as.integer(GameStats$data$fixture$competitors$score[2])
StatLine<-NULL
Ender<-1
if(Type==1) StatLine<-StatKey2 else StatLine<-GoalieStats
if(Type==1) AdvStats<-AdvPlayerStats else AdvStats<-AdvGoalie
if(Type==2) Ender<-0
Names<-GameStats$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$personName
Ids<-GameStats$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$personId
Position<-GameStats$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$position
Bib<-as.integer(GameData$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$bib)
GameFile<-data.frame(
PlayerName=Names,
PlayerID=Ids,
Position=Position,
Bib=Bib
)
GameFile$Season<-2026
GameFile$GameDate<-GameDate
GameFile$GameId<-GameID
GameFile$HomeAway<-"home"
GameFile$TeamName<-HomeTeam
GameFile$OpponentName<-AwayTeam
GameFile$TeamScore<-HomeScore
GameFile$OpponentScore<-AwayScore
GameFile$GameWinner<-HomeScore>AwayScore
for(w in c(1:length(StatLine))){
# print(StatLine[w])
Stat<-str_split(StatLine[w], ":")[[1]]
StatBox<-GameData$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$statistics%>%select(StatLine[w])%>%
separate_wider_delim(delim="/", names=Stat, cols=StatLine[w])%>%as.data.frame()
for(r in c(1:dim(StatBox)[2])){
StatBox[,r]<-as.numeric(StatBox[,r])
}
GameFile<-GameFile%>%bind_cols(StatBox)
# GameFile[StatLine[w]]<-GameData$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$statistics[StatLine[w]]
# GameFile[,StatLine[w]]<-ifelse(is.na(GameFile[,StatLine[w]]), 0, GameFile[,StatLine[w]])
# GameFile[StatLine[w]]<-as.integer(GameFile[StatLine[w]])
}
for(w in c(1:length(AdvStats))){
# print(str_split(AdvStats[w], ":")[[1]])
Stat<-str_split(AdvStats[w], ":")[[1]]
StatBox<-GameData$data$statistics$data$advanced$home$persons[3]$rows[Type][[1]]$statistics%>%select(AdvStats[w])%>%
separate_wider_delim(delim="/", names=Stat, cols=AdvStats[w])%>%as.data.frame()
for(r in c(1:dim(StatBox)[2])){
if(w<length(AdvStats)-Ender){
StatBox[,r]<-as.numeric(StatBox[,r])
}
}
GameFile<-GameFile%>%bind_cols(StatBox)
# GameFile[AdvStats[w]]<-GameData$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$statistics[AdvStats[w]]
# GameFile[StatLine[w]]<-as.integer(GameFile[StatLine[w]])
}
# if(Type==2){
#   GameFile$goalKeeperFastBreakShotsAgai<-GameFile$goalKeeperFastBreakShotsSaved/(GameFile$goalKeeperFastBreakSaveAccuracy/100)-GameFile$goalKeeperFastBreakShotsSaved
#   GameFile$goalKeeperNineMetreShots<-GameFile$goalKeeperNineMetreShotsSaved/(GameFile$goalKeeperNineMetreCentreSaveAccuracy/100)-GameFile$goalKeeperNineMetreShotsSaved
# }
Names<-GameStats$data$statistics$data$base$away$persons[3]$rows[Type][[1]]$personName
Ids<-GameStats$data$statistics$data$base$away$persons[3]$rows[Type][[1]]$personId
Position<-GameStats$data$statistics$data$base$away$persons[3]$rows[Type][[1]]$position
Bib<-as.integer(GameData$data$statistics$data$base$away$persons[3]$rows[Type][[1]]$bib)
GameFile2<-data.frame(
PlayerName=Names,
PlayerID=Ids,
Position=Position,
Bib=Bib
)
GameFile2$Season<-2026
GameFile2$GameDate<-GameDate
GameFile2$GameId<-GameID
GameFile2$HomeAway<-"away"
GameFile2$TeamName<-AwayTeam
GameFile2$OpponentName<-HomeTeam
GameFile2$TeamScore<-AwayScore
GameFile2$OpponentScore<-HomeScore
GameFile2$GameWinner<-HomeScore<AwayScore
for(w in c(1:length(StatLine))){
Stat<-str_split(StatLine[w], ":")[[1]]
StatBox<-GameData$data$statistics$data$base$away$persons[3]$rows[Type][[1]]$statistics%>%select(StatLine[w])%>%
separate_wider_delim(delim="/", names=Stat, cols=StatLine[w])%>%as.data.frame()
for(r in c(1:dim(StatBox)[2])){
StatBox[,r]<-as.numeric(StatBox[,r])
}
GameFile2<-GameFile2%>%bind_cols(StatBox)
# GameFile2[StatLine[w]]<-GameData$data$statistics$data$base$away$persons[3]$rows[Type][[1]]$statistics[StatLine[w]]
# GameFile2[,StatLine[w]]<-ifelse(is.na(GameFile2[,StatLine[w]]), 0, GameFile2[,StatLine[w]])
# GameF2ile[StatLine[w]]<-as.integer(GameFile[StatLine[w]])
}
for(w in c(1:length(AdvStats))){
Stat<-str_split(AdvStats[w], ":")[[1]]
StatBox<-GameData$data$statistics$data$advanced$away$persons[3]$rows[Type][[1]]$statistics%>%select(AdvStats[w])%>%
separate_wider_delim(delim="/", names=Stat, cols=AdvStats[w])%>%as.data.frame()
for(r in c(1:dim(StatBox)[2])){
if(w<length(AdvStats)-Ender){
StatBox[,r]<-as.numeric(StatBox[,r])
}
}
GameFile2<-GameFile2%>%bind_cols(StatBox)
# GameFile2<-GameFile2%>%bind_cols(GameData$data$statistics$data$advanced$away$persons[3]$rows[Type][[1]]$statistics%>%select(AdvStats[w])%>%
# separate_wider_delim(delim="/", names=Stat, cols=AdvStats[w]))
# GameFile[AdvStats[w]]<-GameData$data$statistics$data$base$home$persons[3]$rows[Type][[1]]$statistics[AdvStats[w]]
# GameFile[StatLine[w]]<-as.integer(GameFile[StatLine[w]])
}
GameFile<-GameFile%>%bind_rows(GameFile2)
return(GameFile)
}
AddPBP<-function(GameID){
GameResponse<-GET(paste0("https://eapi.web.prod.cloud.atriumsports.com/v1/embed/248/fixture_detail?locale=de-DE&state=eJwVzDEKwzAMheGrBM0VWJZVo-5dewcptqZSAtkScvdG2_fD452ww2sBr6xco6CsJkh0y1QCRWor5kOfo8FjgW-O5w_fn6wja_MtHWnjdQxSxsa93TczULsVLN2FPWiaEVx_dj4cww&fixtureId=", GameID))
GameStats = fromJSON(rawToChar(GameResponse$content))
GameDate<-substring(GameStats$data$fixture$startTimeLocal, 1, 10)
Teams<-data.frame(TeamName=GameStats$data$fixture$competitors$name,
entityID=GameStats$data$fixture$competitors$entityId)
Events<-data.frame()
for(i in c(1:nrow(GameStats$data$pbp$`1`$events))){
Clock<-GameStats$data$pbp$`1`$events$clock[i]
Clock<-substring(Clock, 1, nchar(Clock)-1)
Mins<-str_extract(Clock, "T([0-9]+)M", group=1)
Sec<-str_extract(Clock, "M([0-9]+)", group=1)
Team<-Teams%>%filter(entityID==GameStats$data$pbp$`1`$events$entityId[i])%>%pull(TeamName)
rbind(Events, data.frame(
season=2026,
gameDate = GameDate,
gameID = GameID,
period = 1,
eventOrder = i,
teamName = Team,
playerName = GameStats$data$pbp$`1`$events$name[i],
playerId=GameStats$data$pbp$`1`$events$personId[i],
gameTime = paste(str_pad(Mins, 2, side="left", pad="0"), str_pad(Sec, 2, side="left", pad="0"), sep=":"),
eventText = GameStats$data$pbp$`1`$events$desc[i],
eventType = GameStats$data$pbp$`1`$events$eventType[i],
eventSubType = GameStats$data$pbp$`1`$events$eventSubType[i],
homeScore = GameStats$data$pbp$`1`$events$scores[[Teams[1,2]]][i],
homeTeam = Teams[1,1],
awayScore = GameStats$data$pbp$`1`$events$scores[[Teams[2,2]]][i],
awayTeam = Teams[2,1],
x = GameStats$data$pbp$`1`$events$x[i],
y = GameStats$data$pbp$`1`$events$y[i]
))->Events
}
for(i in c(1:nrow(GameStats$data$pbp$`2`$events))){
Clock<-GameStats$data$pbp$`2`$events$clock[i]
Clock<-substring(Clock, 1, nchar(Clock)-1)
Mins<-as.integer(str_extract(Clock, "T([0-9]+)M", group=1))+30
Sec<-str_extract(Clock, "M([0-9]+)", group=1)
Team<-Teams%>%filter(entityID==GameStats$data$pbp$`2`$events$entityId[i])%>%pull(TeamName)
rbind(Events, data.frame(
season=2026,
gameDate = GameDate,
gameID = GameID,
period = 2,
eventOrder = i+nrow(GameStats$data$pbp$`1`$events),
teamName = Team,
playerName = GameStats$data$pbp$`2`$events$name[i],
playerId=GameStats$data$pbp$`2`$events$personId[i],
gameTime = paste(str_pad(Mins, 2, side="left", pad="0"), str_pad(Sec, 2, side="left", pad="0"), sep=":"),
eventText = GameStats$data$pbp$`2`$events$desc[i],
eventType = GameStats$data$pbp$`2`$events$eventType[i],
eventSubType = GameStats$data$pbp$`2`$events$eventSubType[i],
homeScore = GameStats$data$pbp$`2`$events$scores[[Teams[1,2]]][i],
homeTeam = Teams[1,1],
awayScore = GameStats$data$pbp$`2`$events$scores[[Teams[2,2]]][i],
awayTeam = Teams[2,1],
x = GameStats$data$pbp$`2`$events$x[i],
y = GameStats$data$pbp$`2`$events$y[i]
))->Events
}
return(Events)
}
