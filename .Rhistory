NewGame<-AddBox(1, GameData,GameIDs[i])
StatsFile<-StatsFile%>%bind_rows(NewGame)
print(paste0(i, " - Need Box ", GameIDs[i]))
}
if(!GameIDs[i]%in%GoalieFile$GameID){
NewGame<-AddBox(2, GameData,GameIDs[i])
NewGame<-NewGame%>%rename(GameID=GameId)
GoalieFile<-GoalieFile%>%bind_rows(NewGame)
print(paste0(i, " - Need Goalie ", GameIDs[i]))
}
if(!GameIDs[i]%in%PBPFile$gameID){
NewGame<-AddPBP(GameIDs[i])
for(G in c(1:nrow(NewGame))){
NewGame$Possesion[G]<-nrow(NewGame%>%
filter(teamName==NewGame$teamName[G] &
gameID==NewGame$gameID[G] &
eventOrder<=NewGame$eventOrder[G] &
(eventType=="goal" |
eventType=="technicalFault" |
eventType=="turnover")))
}
PBPGet<-PBPGet%>%bind_rows(NewGame)
print(paste0(i, " - Need PBP ", GameIDs[i]))
}
}
}
# write.csv(StatsFile, "C:/Users/Patrick/OneDrive/Public/HBL-Stats/HBL-Box-Roster.csv", row.names = F)
