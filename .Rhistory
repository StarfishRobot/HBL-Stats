# write.csv(PBPFile, "C:/Users/Patrick/OneDrive/Public/HBL-Stats/PlayByPlay/HBL-Box-PBP-DE-2025.csv", row.names = F)
PBP<-PBPGet
PBP<-PBP%>%mutate(eventMinute = as.integer(stringr::str_split(string = gameTime, pattern = ":", simplify = T)[,1]))
PBP<-PBP%>%mutate(eventSecond = as.integer(stringr::str_split(string = gameTime, pattern = ":", simplify = T)[,2]))
for(i in c(1:nrow(PBP))){
cat("\r", paste0(replicate(i/nrow(PBP)*10, "="), ">", collapse=""))
PBP$Possesion[i]<-nrow(PBP%>%
filter(teamName==PBP$teamName[i] &
gameID==PBP$gameID[i] &
eventOrder<=PBP$eventOrder[i] &
(eventType=="goal" |
eventType=="technicalFault" |
eventType=="turnover")))
}
print("Goalie Status")
CurGame<-PBP$gameID[1]
HomeEmpty<-0
AwayEmpty<-0
PBP$HomeEmpty<-ifelse(PBP$teamName==PBP$homeTeam,
ifelse(PBP$eventType=="goalKeeperChange",
ifelse(is.na(PBP$playerName), 1, 0), NA), NA)
PBP$AwayEmpty<-ifelse(PBP$teamName==PBP$awayTeam,
ifelse(PBP$eventType=="goalKeeperChange",
ifelse(is.na(PBP$playerName), 1, 0), NA), NA)
PBP<-PBP%>%fill(HomeEmpty)%>%fill(AwayEmpty)%>%replace_na(list(HomeEmpty=0, AwayEmpty=0))
