filter(teamName==NewGame$teamName[G] &
gameID==NewGame$gameID[G] &
eventOrder<=NewGame$eventOrder[G] &
(eventType=="goal" |
eventType=="technicalFault" |
eventType=="turnover")))
}
PBPGet<-PBPGet%>%bind_rows(NewGame)
print(paste0(i, " - Need PBP ", GameIDs[i]))
}
}
}
